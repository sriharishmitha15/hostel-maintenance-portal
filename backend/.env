# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-hostel-portal-key-change-in-production
JWT_SECRET_KEY=jwt-secret-hostel-maintenance-token-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MySQL Database Configuration
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostel_maintenance_db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/hostel_maintenance_db

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
